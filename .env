

database_url="mysql+pymysql://hr_attendance:_$+-No!ui&WA@ASSETTERS.COM/ePortal_attendance"
database_url2="mysql+pymysql://hr_attendance:_$+-No!ui&WA@ASSETTERS.COM/exanzbrk_payroll"

api-url="https://eportal-api-attendance.onrender.com/attendance/"
api-url-summary="https://eportal-api-attendance.onrender.com/summary/cron/"
api-url-voucher="https://eportal-api-attendance.onrender.com/voucher/generate-vouchers/"

api_key=""


# CITYLAND
device_ip=192.168.0.129
device_port=4370

device_ip_1108=192.168.0.3
device_port_1108=1108

#  CEBU
device_ip_cebu=192.168.254.175
device_port_cebu=4370

#  ONE CENTRAL
device_ip_oc=192.168.254.173
device_port_oc=1080

 
# Cloudflare D1 backup collector (set URL and token, then enable)
ENABLE_D1_BACKUP=true
D1_BACKUP_URL=https://attendance-d1-backup.dsd5-81property.workers.dev/raw-attendance-events
D1_BACKUP_TOKEN=-6QP:X_aMrcm_Z7
D1_BACKUP_DEVICE_IP=${device_ip}
D1_BACKUP_DEVICE_PORT=${device_port}
D1_BACKUP_DEVICE_IP_1108=${device_ip_1108}
D1_BACKUP_DEVICE_PORT_1108=${device_port_1108}
D1_BACKUP_DAYS=1
# Set D1_BACKUP_DAYS=all to archive every retained activity from each device.

# Separate D1 Worker endpoints. Set URL2 for ONE CENTRAL and URL3 for CEBU.
# Leave a token blank only when that Worker intentionally shares the primary
# D1_BACKUP_TOKEN; otherwise set its own token below.
D1_BACKUP_URL2=https://attendance-d1-backup-oc.attendance-d1-backup-oc.workers.dev
D1_BACKUP_TOKEN2=-6QP:X_aMrcm_Z8
D1_BACKUP_URL3=https://attendance-d1-backup-cebu.attendance-d1-backup-cebu.workers.dev
D1_BACKUP_TOKEN3=-6QP:X_aMrcm_Z9
 

# ONE CENTRAL D1 backup device (keep this independent from every other device).
D1_BACKUP_OC_DEVICE_IP=${device_ip_oc}
D1_BACKUP_OC_DEVICE_PORT=${device_port_oc}

# CEBU D1 backup device (keep this independent from every other device).
D1_BACKUP_CEBU_DEVICE_IP=${device_ip_cebu}
D1_BACKUP_CEBU_DEVICE_PORT=${device_port_cebu}
